PORT=3001
HOST=0.0.0.0
# Comma-separated CORS allowlist (required in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Max message body length (chars)
MAX_MESSAGE_LENGTH=4000
# Messages per second burst per socket
RATE_LIMIT_PER_SEC=5
# Persist chat history to JSON file (survives restarts)
PERSISTENCE_PATH=./data/chat-store.json
# How often to flush persistence (ms)
PERSISTENCE_FLUSH_MS=2000
NODE_ENV=development
